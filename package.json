{
  "name": "max-and-gym",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.1.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@mui/x-charts": "^6.19.8",
    "@mui/x-date-pickers": "^6.20.2",
    "dayjs": "^1.11.13",
    "dexie": "^3.2.7",
    "dexie-react-hooks": "^1.1.7",
    "dom-to-image": "^2.6.0",
    "emoji-picker-react": "^4.12.0",
    "i18next": "^23.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^13.5.0",
    "react-image-file-resizer": "^0.4.8",
    "react-router-dom": "7.18.2",
    "standardized-audio-context": "^25.3.77",
    "uuid": "14.0.1"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "preview": "node scripts/preview.mjs",
    "serve": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint vite.config.ts capacitor.config.ts playwright.config.ts tests src/App.tsx src/AppRoutes.tsx src/index.tsx src/config src/context/settingsContext.tsx src/diagnostics src/backup src/progress src/pwa src/native src/pages/diagnostics src/pages/backup src/pages/progress src/pages/shell src/pages/workout-active src/pages/library src/pages/programs src/pages/progression src/programs src/generator src/progression src/workout src/exerciseCatalog src/theme src/components/ui src/components/errorBoundary.tsx src/components/nav.tsx src/components/layout.tsx src/components/app_bar.tsx --ext .ts,.tsx --max-warnings 0",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs src/diagnostics",
    "test:components": "node scripts/run-tests.mjs src/components",
    "test:migrations": "node scripts/run-tests.mjs src/db",
    "test:e2e": "playwright test --project=chromium-412",
    "test:offline": "playwright test --grep @offline --project=chromium-412",
    "test:visual": "playwright test --grep @visual",
    "test:a11y": "playwright test --grep @a11y",
    "test:release": "playwright test",
    "build": "tsc --noEmit && node scripts/build.mjs && node scripts/bundle-report.mjs && node scripts/smoke-pages.mjs",
    "build:pages": "npm run build",
    "build:android:web": "tsc --noEmit && node scripts/build-android.mjs && node scripts/smoke-android.mjs",
    "android:sync": "npm run build:android:web && cap sync android",
    "audit:android": "node scripts/audit-android-release.mjs",
    "doctor": "node scripts/doctor.mjs",
    "audit:project": "node scripts/audit-project.mjs",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:accessibility": "node scripts/audit-accessibility.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "audit:network": "node scripts/audit-network.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "audit:exercise-assets": "node scripts/audit-exercise-assets.mjs",
    "audit:language": "node scripts/audit-language.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run test:migrations && npm run audit:dependencies && npm run audit:architecture && npm run audit:android && npm run audit:project && npm run audit:network && npm run audit:licenses && npm run audit:assets && npm run audit:exercise-assets && npm run audit:language && npm run build && npm run audit:accessibility && npm run audit:performance"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/dom-to-image": "^2.6.7",
    "@types/jest": "^27.5.2",
    "@types/node": "24.13.3",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-react-swc": "4.3.2",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fake-indexeddb": "6.0.0",
    "jsdom": "22.1.0",
    "react-geiger": "^1.2.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
